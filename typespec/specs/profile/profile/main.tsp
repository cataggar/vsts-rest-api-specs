  },
  termsOfService: "https://go.microsoft.com/fwlink/?LinkId=329770",
})
@server("https://app.vssps.visualstudio.com")
namespace Profile;

/** Identifies an attribute with a name and a container. */
model AttributeDescriptor {
  /** The name of the attribute. */
  attributeName?: string;

  /** The container the attribute resides in. */
  containerName?: string;
}

/** Stores a set of named profile attributes. */
model AttributesContainer {
  /** The attributes stored by the container. */
  attributes?: Record<ProfileAttribute>;

  /** The name of the container. */
  containerName?: string;

  /** The maximum revision number of any attribute within the container. */
  revision?: int32;
}

model Avatar {
  isAutoGenerated?: boolean;
  @extension(
    "x-ms-enum",
    #{
      name: "AvatarSize",
      values: #[
        #{ value: "small", description: "" },
        #{ value: "medium", description: "" },
        #{ value: "large", description: "" }
      ],
    }
  )
  size?: "small" | "medium" | "large";
  timeStamp?: utcDateTime;
  value?: bytes[];
}

/** A profile attribute which always has a value for each profile. */
model CoreProfileAttribute {
  ...ProfileAttributeBase;
}

model CreateProfileContext {
  ciData?: Record<{}>;
  contactWithOffers?: boolean;
  countryName?: string;
  displayName?: string;
  emailAddress?: string;
  hasAccount?: boolean;
  language?: string;
  phoneNumber?: string;

  /** The current state of the profile. */
  @extension(
    "x-ms-enum",
    #{
      name: "ProfileState",
      values: #[
        #{ value: "custom", description: "The profile is in use." },
        #{ value: "customReadOnly", description: "The profile is in use, but can only be read." },
        #{ value: "readOnly", description: "The profile may only be read." }
      ],
    }
  )
  profileState?: "custom" | "customReadOnly" | "readOnly";
}

model GeoRegion {
  regionCode?: string;
}

/** Represents a JSON object. */
model JObject {
  @format("JToken") item?: string;

  /** Gets the node type for this JToken. */
  @format("JTokenType") type?: string;
}

/** A user profile. */
model Profile {
  applicationContainer?: AttributesContainer;

  /** The core attributes of this profile. */
  coreAttributes?: Record<CoreProfileAttribute>;

  /** The maximum revision number of any attribute. */
  coreRevision?: int32;

  /** The unique identifier of the profile. */
  @format("uuid") id?: string;

  /** The current state of the profile. */
  @extension(
    "x-ms-enum",
    #{
      name: "ProfileState",
      values: #[
        #{ value: "custom", description: "The profile is in use." },
        #{ value: "customReadOnly", description: "The profile is in use, but can only be read." },
        #{ value: "readOnly", description: "The profile may only be read." }
      ],
    }
  )
  profileState?: "custom" | "customReadOnly" | "readOnly";

  /** The maximum revision number of any attribute. */
  revision?: int32;

  /** The time at which this profile was last changed. */
  timeStamp?: utcDateTime;
}

/** A named object associated with a profile. */
model ProfileAttribute {
  ...ProfileAttributeBase;
}

model ProfileAttributeBase {
  descriptor?: AttributeDescriptor;

  /** The revision number of the attribute. */
  revision?: int32;

  /** The time the attribute was last changed. */
  timeStamp?: utcDateTime;

  /** The value of the attribute. */
  @format("T") value?: string;
}

/** Country/region information */
model ProfileRegion {
  /** The two-letter code defined in ISO 3166 for the country/region. */
  code?: string;

  /** Localized country/region name */
  name?: string;
}

/** Container of country/region information */
model ProfileRegions {
  /** List of country/region code with contact consent requirement type of notice */
  noticeContactConsentRequirementRegions?: string[];

  /** List of country/region code with contact consent requirement type of opt-out */
  optOutContactConsentRequirementRegions?: string[];

  /** List of country/regions */
  regions?: ProfileRegion[];
}

/** This class is used to serialize collections as a single JSON object on the wire. */
model VssJsonCollectionWrapper {
  ...VssJsonCollectionWrapperBase;

  /** The serialized item. */
  @format("T") value?: string;
}

model VssJsonCollectionWrapperBase {
  /** The number of serialized items. */
  count?: int32;
}

/** Gets a user profile. */
@tag("Profiles")
@extension("x-ms-docs-override-version", "7.2-preview.3")
@extension("x-ms-vss-resource", "profiles")
@extension("x-ms-vss-method", "GetProfile")
@extension("x-ms-preview", true)
@route("/_apis/profile/profiles/{id}")
@get
op Profiles_Get(
  /** The ID of the target user profile within the same organization, or 'me' to get the profile of the current authenticated user. */
  @path id: string,

  /** Return public profile information such as display name, email address, country, etc. If false, the withAttributes parameter is ignored. */
  @query(#{ explode: true }) details?: boolean,

  /** If true, gets the attributes (named key-value pairs of arbitrary data) associated with the profile. The partition parameter must also have a value. */
  @query(#{ explode: true }) withAttributes?: boolean,

  /** The partition (named group) of attributes to return. */
  @query(#{ explode: true }) partition?: string,

  /** A comma-delimited list of core profile attributes to return. Valid values are Email, Avatar, DisplayName, and ContactWithOffers. */
  @query(#{ explode: true }) coreAttributes?: string,

  /** Not used in this version of the API. */
  @query(#{ explode: true }) forceRefresh?: boolean,

  ...Parameters.`api-Version-preview`.`3`,
): Profile;

namespace Parameters {
  namespace `api-Version-preview` {
    model `1` {
      /** Version of the API to use. This should be set to '7.2-preview.1' to use this version of the api. */
      @query(#{ explode: true }) `api-version`: string;
    }
    model `2` {
      /** Version of the API to use. This should be set to '7.2-preview.2' to use this version of the api. */
      @query(#{ explode: true }) `api-version`: string;
    }
    model `3` {
      /** Version of the API to use. This should be set to '7.2-preview.3' to use this version of the api. */
      @query(#{ explode: true }) `api-version`: string;
    }
  }
}
